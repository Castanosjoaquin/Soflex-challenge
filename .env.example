# Copy to .env (never commit .env). With no key set, the app runs in mock mode.

# mock | openai_compat
LLM_PROVIDER=mock

# Any OpenAI-compatible endpoint works:
#   Groq:   https://api.groq.com/openai/v1                          (model: llama-3.3-70b-versatile)
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/ (model: gemini-2.5-flash)
#   Ollama: http://host.docker.internal:11434/v1                     (model: llama3.1, any non-empty key)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# Seconds the Lector con IA gets per lectura; past it, the lectura goes on with rules only.
LLM_TIMEOUT_SECONDS=8
